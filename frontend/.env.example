# Optional. By default the app calls /api, which the Vite dev proxy forwards to
# the backend on this machine (see vite.config.ts).
#
# Set this only when the API lives somewhere fixed, e.g. in production:
# VITE_API_URL=https://api.careernet.example.com
#
# Used by vite.config.ts to point the dev proxy at a backend on another machine.
# VITE_BACKEND_URL=http://127.0.0.1:8000
