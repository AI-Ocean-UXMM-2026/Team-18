# =============================================================================
#  CareerNest — backend configuration
#  Copy this file to ".env" (same folder) and edit the values.
#      Windows PowerShell:  copy .env.example .env
#      macOS / Linux:       cp .env.example .env
#  NEVER share, zip or commit your real .env — it holds passwords and API keys.
# =============================================================================

# --- PostgreSQL -------------------------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Special characters in the password must be percent-encoded:  # -> %23   @ -> %40
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/careernet_db

# --- Direct career video uploads (Supabase Storage) -------------------------
# Keep the service role key on the backend only. The video bucket is created
# automatically as a public bucket when an admin starts the first upload.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_VIDEO_BUCKET=career-videos

# --- Sessions ---------------------------------------------------------------
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# --- Server -----------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LAN addresses are allowed by default (phone on the same Wi-Fi).
# Set to an empty value before publishing on the internet:
# CORS_ORIGIN_REGEX=

# --- Seeding ----------------------------------------------------------------
# Creates demo admin + mentor accounts with free time slots on startup.
# Set to false once you have real accounts, and change every seeded password.
SEED_ON_START=true
SEED_PASSWORD=careernet123

# --- School data (GED / IGCSE) ------------------------------------------------
# Google Sheets: File > Share > Publish to web > sheet "schools" > CSV.
# Leave empty to use backend/data/schools.csv.
SCHOOLS_SHEET_CSV_URL=
SCHOOLS_CACHE_SECONDS=600

# --- Pro --------------------------------------------------------------------
PRO_PRICE_MMK=5000
FREE_AI_LIMIT=5
# Payment screenshots are deleted this many hours after approve/reject.
PROOF_RETENTION_HOURS=240

# --- AI -----------------------------------------------------------------------
AI_PROVIDER=gemini              # gemini or claude
GEMINI_API_KEY=
# Optional second Gemini key. Used once only when the primary key is rate-limited (HTTP 429).
GEMINI_FALLBACK_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional fallback provider. OpenRouter is used only when OPENROUTER_MODEL ends in :free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_REFERER=https://careernet-team-18-web.onrender.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
AI_RATE_LIMIT_PER_HOUR=30

# --- Login protection -----------------------------------------------------------
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
