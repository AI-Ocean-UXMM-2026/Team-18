{
  "name": "careernet-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "CareerNet REST API: Express + PostgreSQL + admin-managed university data + AI (Gemini or Claude)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-data.mjs",
    "serve": "node dist/src/index.js",
    "check": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "jose": "^6.1.0",
    "papaparse": "^5.4.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/papaparse": "^5.3.14",
    "@types/pg": "^8.15.4",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vitest": "^2.1.4"
  }
}
